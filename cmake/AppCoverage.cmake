# App-only LLVM coverage; Core and its generated sources keep their own flags.
include_guard(GLOBAL)
function(app_instrument directory)
  if(directory MATCHES "^${CMAKE_SOURCE_DIR}/bitcoin($|/)")
    return()
  endif()
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    if(type MATCHES "^(STATIC_LIBRARY|SHARED_LIBRARY|OBJECT_LIBRARY|EXECUTABLE)$")
      target_compile_options("${target}" PRIVATE -fprofile-instr-generate -fcoverage-mapping -fprofile-update=atomic)
      if(type MATCHES "^(SHARED_LIBRARY|EXECUTABLE)$")
        target_link_options("${target}" PRIVATE -fprofile-instr-generate)
      endif()
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    app_instrument("${child}")
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL app_instrument "${CMAKE_SOURCE_DIR}")
